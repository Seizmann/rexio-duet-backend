# RexiO Duet Backend — local environment template.
#
# Copy to `.env` and fill from private-project-data.md. Never commit the filled file.
# Deployed environments inject these from the CI/CD secret store instead.

# Primary SQL Storage pooler connection string
MAIN_DATABASE_URL=

# Isolated Postgres Cluster pooler connection string (vent + audit logs)
SENSITIVE_DATABASE_URL=

# JWT signing secret — must match the value the proxy layer validates against
JWT_SECRET=

# Gateway envelope encryption key — base64-encoded 32 bytes
# Generate with: openssl rand -base64 32
GATEWAY_PAYLOAD_KEY=

# Gateway request-signing key (HMAC-SHA256)
GATEWAY_SIGNING_KEY=

# Vent-at-rest encryption key — base64-encoded 32 bytes. Rotating this without
# re-wrapping existing rows makes stored vents unreadable; plan migrations carefully.
VENT_ENCRYPTION_KEY=

PORT=40000
